# WebAgent Environment Variables Template
# Copy this file to .env or configure directly via the Web UI Settings panel (⚙️)

# Cartesia Speech-to-Text & Text-to-Speech API Key (https://cartesia.ai)
CARTESIA_API_KEY=sk_car_your_cartesia_key_here

# ElevenLabs Text-to-Speech API Key (https://elevenlabs.io)
ELEVENLABS_API_KEY=sk_your_elevenlabs_key_here

# Groq LLM API Key (https://groq.com)
GROQ_API_KEY=gsk_your_groq_key_here

# Gemini LLM API Key (Fallback) (https://ai.google.dev)
GEMINI_API_KEY=AIzaSy_your_gemini_key_here
